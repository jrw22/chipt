{
  "components": {
    "schemas": {
      "AnalysisOut": {
        "properties": {
          "available_groups": {
            "items": {
              "$ref": "#/components/schemas/ComparisonGroup"
            },
            "title": "Available Groups",
            "type": "array"
          },
          "discipline": {
            "$ref": "#/components/schemas/Discipline"
          },
          "distance_label": {
            "title": "Distance Label",
            "type": "string"
          },
          "most_recent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "most_recent_vs_pb_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "most_recent - pb; 0 means recent is PB",
            "title": "Most Recent Vs Pb Seconds"
          },
          "pb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "description": "Sorted by event_date ascending",
            "items": {
              "$ref": "#/components/schemas/AnalysisPoint"
            },
            "title": "Points",
            "type": "array"
          },
          "trend": {
            "description": "improving | declining | flat | insufficient_data",
            "title": "Trend",
            "type": "string"
          },
          "trend_seconds_per_year": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Linear-fit slope; negative = getting faster",
            "title": "Trend Seconds Per Year"
          }
        },
        "required": [
          "discipline",
          "distance_label",
          "points",
          "pb",
          "most_recent",
          "trend"
        ],
        "title": "AnalysisOut",
        "type": "object"
      },
      "AnalysisPoint": {
        "properties": {
          "chip_time": {
            "title": "Chip Time",
            "type": "string"
          },
