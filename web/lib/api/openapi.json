          },
          "event_date": {
            "format": "date",
            "title": "Event Date",
            "type": "string"
          },
          "event_name": {
            "title": "Event Name",
            "type": "string"
          },
          "is_pb": {
            "default": false,
            "title": "Is Pb",
            "type": "boolean"
          },
          "pace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "M:SS /km",
