# =============================================================================
# Chipt — example environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit your real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# PostgreSQL (MVP: local Docker container) — spec §5.2, §6
# -----------------------------------------------------------------------------
POSTGRES_USER=chipt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chipt
POSTGRES_HOST=localhost
POSTGRES_PORT=5433            # host port for the Docker container (5433 avoids a native Postgres on 5432)

# Full connection string used by the app (SQLAlchemy / asyncpg).
# Keep in sync with the values above.
DATABASE_URL=postgresql+asyncpg://chipt:change-me@localhost:5433/chipt

# Plain libpq URI for the Postgres MCP server (.mcp.json) — no "+asyncpg" driver suffix.
# Claude Code reads this from your shell environment, not from .env, so export it
# before launching `claude` (e.g. `set -a; source .env; set +a`).
MCP_DATABASE_URI=postgresql://chipt:change-me@localhost:5433/chipt

# Minimum pg_trgm similarity score (0–1) for a result to count as a search candidate — §5.6
SEARCH_SIMILARITY_THRESHOLD=0.3
SEARCH_MAX_RESULTS=50

# -----------------------------------------------------------------------------
# FastAPI backend — spec §5.8
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API (the Next.js web app)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Next.js frontend (V1), web/. Put overrides in web/.env.local, not here: Next.js only
# reads env files in web/. NEXT_PUBLIC_* values are compiled into browser code, so never secrets.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000   # default if unset

# -----------------------------------------------------------------------------
# MVP identity — single hardcoded athlete profile (spec §4)
# -----------------------------------------------------------------------------
DEFAULT_ATHLETE_ID=1
DEFAULT_ATHLETE_DISPLAY_NAME=Your Name

# -----------------------------------------------------------------------------
# Ingestion / scraping — spec §5.5, §6
# -----------------------------------------------------------------------------
# Identify the client honestly; include a way for site owners to contact you.
SCRAPER_USER_AGENT="ChiptBot/0.1 (+https://example.com/contact)"
SCRAPER_RATE_LIMIT_SECONDS=2.0      # minimum delay between requests to the same host
SCRAPER_REQUEST_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RESPECT_ROBOTS_TXT=true
SCRAPER_CACHE_DIR=./.cache/raw      # cached raw responses, so parsing can be re-run without re-fetching
SCRAPER_CACHE_ENABLED=true

# Playwright (for JS-rendered sites)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium         # chromium | firefox | webkit

# MVP provider base URLs
PROVIDER_RESULTSBASE_BASE_URL=https://www.resultsbase.net
PROVIDER_RUNTHROUGH_BASE_URL=https://results.runthrough.co.uk   # user-run only (AI opt-out), see docs/providers/runthrough.md
PROVIDER_EVENTCHIPTIMING_BASE_URL=https://results.eventchiptiming.com   # user-run only (AI opt-out), see docs/providers/eventchiptiming.md
PROVIDER_EVENTRAC_BASE_URL=https://www.eventrac.co.uk   # route 1 (direct scrape), see docs/providers/eventrac.md
PROVIDER_RACEBEST_BASE_URL=https://racebest.com
PROVIDER_UKRESULTS_BASE_URL=https://www.ukresults.net

# -----------------------------------------------------------------------------
# V1 — provider API keys (when migrating from scraping to API feeds, §3 V1)
# -----------------------------------------------------------------------------
# PROVIDER_<SLUG>_API_KEY=

# -----------------------------------------------------------------------------
# V2 — auth (decision pending: FastAPI + JWT, or Clerk / Supabase Auth)
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# CLERK_SECRET_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Later — LLM integration (Anthropic / Claude API)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
